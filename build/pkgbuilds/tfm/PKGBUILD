# Maintainer: labjankiness
#
# Source is vendored under ./source/ (originally from labjankiness/Terminal-File-Manager)
# rather than fetched from a repo, so this build has no external dependency.
pkgname=tfm
pkgver=0.1.0
pkgrel=1
pkgdesc="Dual-panel TUI file manager for Linux built in Rust with ratatui"
arch=('x86_64')
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')

build() {
    cd "$startdir/source"
    cargo build --release --locked --target-dir "$srcdir/target"
}

package() {
    install -Dm755 "$srcdir/target/release/tfm" "$pkgdir/usr/bin/tfm"
}
